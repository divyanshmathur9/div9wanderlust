<% layout("/layouts/boilerplate") %>
<header class="home-hero page-shell">
  <div class="hero-copy reveal"><p class="eyebrow"><span></span> Thoughtfully chosen stays</p><h1>Go somewhere<br><em>worth remembering.</em></h1><p>Discover remarkable homes, soulful escapes, and places that turn a simple trip into your favourite story.</p>
    <form class="hero-search" action="/listings" method="GET"><span class="search-icon"><i class="fa-solid fa-location-dot"></i></span><div class="search-copy"><label for="hero-query">Where to?</label><input id="hero-query" name="q" value="<%= query.q %>" placeholder="City, region, or landmark"></div><button type="submit">Find your stay <i class="fa-solid fa-arrow-right"></i></button></form>
    <div class="hero-trust" aria-label="Wanderlust highlights"><div><strong><%= totalListings %>+</strong><span>unique stays</span></div><div><strong>24/7</strong><span>trip support</span></div><div><strong>100%</strong><span>secure booking</span></div></div>
  </div>
  <a class="hero-feature reveal reveal-delay" href="/listings?category=mountains" aria-label="Explore mountain homes"><div class="hero-feature-top"><span class="feature-label"><i class="fa-regular fa-compass"></i> Editor’s escape</span><span class="feature-arrow"><i class="fa-solid fa-arrow-up-right-from-square"></i></span></div><div class="hero-feature-bottom"><small>Himalayan collection</small><strong>Wake up above<br>the clouds.</strong><span>Explore mountain homes <i class="fa-solid fa-arrow-right"></i></span></div></a>
</header>
<main class="listing-page">
  <div class="category-wrap"><div class="page-shell category-row" aria-label="Listing categories"><a class="category-pill <%= !query.category ? 'active' : '' %>" href="/listings<%= buildQueryString(query, { category: '', page: 1 }) %>"><i class="fa-solid fa-border-all"></i><span>All stays</span></a><% for (const category of categories) { %><a class="category-pill <%= query.category === category.slug ? 'active' : '' %>" href="/listings<%= buildQueryString(query, { category: category.slug, page: 1 }) %>"><i class="fa-solid <%= category.icon %>"></i><span><%= category.label %></span></a><% } %></div></div>
  <section class="page-shell collection-section">
    <div class="results-bar"><div><p class="eyebrow"><span></span> Curated collection</p><h2><%= query.q ? `Places matching “${query.q}”` : 'Stays worth the journey' %></h2><p><%= totalListings %> handpicked <%= totalListings === 1 ? 'place' : 'places' %> to discover</p></div><form class="sort-form" action="/listings" method="GET"><input type="hidden" name="q" value="<%= query.q %>"><input type="hidden" name="category" value="<%= query.category %>"><label for="sort">Sort</label><select id="sort" name="sort" onchange="this.form.submit()"><option value="newest" <%= query.sort === 'newest' ? 'selected' : '' %>>Newest first</option><option value="price-asc" <%= query.sort === 'price-asc' ? 'selected' : '' %>>Price: low to high</option><option value="price-desc" <%= query.sort === 'price-desc' ? 'selected' : '' %>>Price: high to low</option></select></form></div>
    <% if (!allListings.length) { %><section class="empty-state"><span><i class="fa-regular fa-compass"></i></span><h2>No stays found</h2><p>Try a different destination or clear your filters.</p><a class="button-primary" href="/listings">Explore all stays</a></section><% } %>
    <div class="listing-grid"><% for (const listing of allListings) { %><article class="stay-card reveal-card"><a class="stay-image" href="/listings/<%= listing._id %>"><img src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=900&q=80' %>" alt="<%= listing.title %> in <%= listing.location %>" loading="lazy"><span class="stay-badge"><i class="fa-solid fa-sparkles"></i> <%= listing.category || 'Featured' %></span><span class="card-explore">View stay <i class="fa-solid fa-arrow-right"></i></span></a><div class="stay-meta"><div class="stay-copy"><a href="/listings/<%= listing._id %>"><h3><%= listing.title %></h3></a><p><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></p><span class="guest-detail"><i class="fa-regular fa-user"></i> Up to <%= listing.maxGuests || 2 %> guests</span></div><div class="stay-price"><strong>₹<%= Number.isFinite(listing.price) ? listing.price.toLocaleString('en-IN') : 'N/A' %></strong><span>per night</span></div></div></article><% } %></div>
    <% if (totalPages > 1) { %><nav class="pagination-nav" aria-label="Listings pagination"><% if (query.page > 1) { %><a class="page-control" href="/listings<%= buildQueryString(query, { page: query.page - 1 }) %>"><i class="fa-solid fa-arrow-left"></i> Previous</a><% } else { %><span class="page-control disabled" aria-disabled="true"><i class="fa-solid fa-arrow-left"></i> Previous</span><% } %><span>Page <strong><%= query.page %></strong> of <%= totalPages %></span><% if (query.page < totalPages) { %><a class="page-control" href="/listings<%= buildQueryString(query, { page: query.page + 1 }) %>">Next <i class="fa-solid fa-arrow-right"></i></a><% } else { %><span class="page-control disabled" aria-disabled="true">Next <i class="fa-solid fa-arrow-right"></i></span><% } %></nav><% } %>
  </section>
</main>

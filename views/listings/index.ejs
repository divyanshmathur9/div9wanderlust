<% layout("/layouts/boilerplate") %>
<header class="home-hero page-shell"><div class="hero-copy"><p class="eyebrow">Stay somewhere unforgettable</p><h1>Find places that feel made for you.</h1><p>Explore characterful homes, honest reviews, and destinations worth the journey.</p>
  <form class="hero-search" action="/listings" method="GET"><i class="fa-solid fa-location-dot"></i><label class="visually-hidden" for="hero-query">Where do you want to go?</label><input id="hero-query" name="q" value="<%= query.q %>" placeholder="Where do you want to go?"><button type="submit">Explore stays</button></form></div>
  <a class="hero-feature" href="/listings?category=mountains"><span>Editor’s escape</span><strong>Wake up above the clouds.</strong><small>Explore mountain homes <i class="fa-solid fa-arrow-right"></i></small></a>
</header>
<main class="page-shell listing-page">
  <div class="category-row" aria-label="Listing categories"><a class="category-pill <%= !query.category ? 'active' : '' %>" href="/listings<%= buildQueryString(query, { category: '', page: 1 }) %>"><i class="fa-solid fa-border-all"></i><span>All stays</span></a><% for (const category of categories) { %><a class="category-pill <%= query.category === category.slug ? 'active' : '' %>" href="/listings<%= buildQueryString(query, { category: category.slug, page: 1 }) %>"><i class="fa-solid <%= category.icon %>"></i><span><%= category.label %></span></a><% } %></div>
  <div class="results-bar"><div><p class="eyebrow">Curated collection</p><h2><%= query.q ? `Results for “${query.q}”` : 'Stays worth the journey' %></h2><p><%= totalListings %> <%= totalListings === 1 ? 'stay' : 'stays' %> found</p></div><form class="sort-form" action="/listings" method="GET"><input type="hidden" name="q" value="<%= query.q %>"><input type="hidden" name="category" value="<%= query.category %>"><label for="sort">Sort by</label><select id="sort" name="sort" onchange="this.form.submit()"><option value="newest" <%= query.sort === 'newest' ? 'selected' : '' %>>Newest</option><option value="price-asc" <%= query.sort === 'price-asc' ? 'selected' : '' %>>Price: low to high</option><option value="price-desc" <%= query.sort === 'price-desc' ? 'selected' : '' %>>Price: high to low</option></select></form></div>
  <% if (!allListings.length) { %><section class="empty-state"><span><i class="fa-regular fa-compass"></i></span><h2>No stays found</h2><p>Try a different destination or clear your filters.</p><a class="button-primary" href="/listings">Explore all stays</a></section><% } %>
  <div class="listing-grid"><% for (const listing of allListings) { %><article class="stay-card"><a class="stay-image" href="/listings/<%= listing._id %>"><img src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=900&q=80' %>" alt="<%= listing.title %> in <%= listing.location %>" loading="lazy"><span class="stay-badge"><%= listing.category || 'Featured' %></span></a><div class="stay-meta"><div><a href="/listings/<%= listing._id %>"><h3><%= listing.title %></h3></a><p><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></p></div><div class="stay-price"><strong>₹<%= Number.isFinite(listing.price) ? listing.price.toLocaleString('en-IN') : 'N/A' %></strong><span>/ night</span></div></div></article><% } %></div>
  <% if (totalPages > 1) { %><nav class="pagination-nav" aria-label="Listings pagination"><% if (query.page > 1) { %><a class="page-control" href="/listings<%= buildQueryString(query, { page: query.page - 1 }) %>"><i class="fa-solid fa-arrow-left"></i> Previous</a><% } else { %><span class="page-control disabled" aria-disabled="true"><i class="fa-solid fa-arrow-left"></i> Previous</span><% } %><span>Page <strong><%= query.page %></strong> of <%= totalPages %></span><% if (query.page < totalPages) { %><a class="page-control" href="/listings<%= buildQueryString(query, { page: query.page + 1 }) %>">Next <i class="fa-solid fa-arrow-right"></i></a><% } else { %><span class="page-control disabled" aria-disabled="true">Next <i class="fa-solid fa-arrow-right"></i></span><% } %></nav><% } %>
</main>

<form method="POST" action="<%= formAction %>" class="needs-validation listing-form" enctype="multipart/form-data" novalidate><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="form-field full"><label for="title">Listing title</label><input id="title" name="listing[title]" value="<%= listing?.title || '' %>" placeholder="e.g. Sunlit villa above the sea" required minlength="3" maxlength="100"><div class="invalid-feedback">Add a clear title.</div></div>
  <div class="form-field full"><label for="description">Description</label><textarea id="description" name="listing[description]" rows="5" placeholder="Describe the space, atmosphere, and what guests will love." required minlength="20" maxlength="2000"><%= listing?.description || '' %></textarea><small>Minimum 20 characters.</small></div>
  <div class="form-field"><label for="category">Category</label><select id="category" name="listing[category]" required><% for (const option of [{v:'trending',l:'Trending'},{v:'beach',l:'Beach'},{v:'mountains',l:'Mountains'},{v:'cities',l:'City break'},{v:'unique',l:'Unique home'}]) { %><option value="<%= option.v %>" <%= (listing?.category || 'trending') === option.v ? 'selected' : '' %>><%= option.l %></option><% } %></select></div>
  <div class="form-field"><label for="maxGuests">Maximum guests</label><input id="maxGuests" name="listing[maxGuests]" type="number" min="1" max="30" value="<%= listing?.maxGuests || 2 %>" required></div>
  <div class="form-field"><label for="price">Nightly price (₹)</label><input id="price" name="listing[price]" type="number" min="0" step="1" value="<%= listing?.price || '' %>" placeholder="4500" required></div>
  <div class="form-field"><label for="country">Country</label><input id="country" name="listing[country]" value="<%= listing?.country || '' %>" placeholder="India" required></div>
  <div class="form-field full"><label for="location">City or location</label><input id="location" name="listing[location]" value="<%= listing?.location || '' %>" placeholder="Manali, Himachal Pradesh" required></div>
  <fieldset class="form-field full amenity-field"><legend>Amenities</legend><% for (const amenity of ['WiFi','Kitchen','Workspace','Parking','Pool','Mountain view']) { %><label><input type="checkbox" name="listing[amenities]" value="<%= amenity %>" <%= listing?.amenities?.includes(amenity) ? 'checked' : '' %>> <%= amenity %></label><% } %></fieldset>
  <% if (originalImageUrl) { %><div class="form-field full current-image"><span>Current image</span><img src="<%= originalImageUrl %>" alt="Current listing image"></div><% } %>
  <div class="form-field full"><label for="image"><%= listing ? 'Replace image (optional)' : 'Listing image' %></label><input id="image" name="listing[image]" type="file" accept="image/jpeg,image/png,image/webp"><small>JPG, PNG, or WebP up to 5MB.</small></div>
  <div class="form-actions"><a href="<%= listing ? `/listings/${listing._id}` : '/listings' %>">Cancel</a><button class="button-primary" type="submit"><%= submitLabel %></button></div>
</form>

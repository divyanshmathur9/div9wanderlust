<% layout("/layouts/boilerplate") %>
<script>const mapToken = "<%= process.env.MAP_TOKEN %>"; const listing = <%- JSON.stringify(listing) %>;</script>
<main class="page-shell detail-page">
  <div class="detail-heading"><div><a href="/listings" class="back-link"><i class="fa-solid fa-arrow-left"></i> All stays</a><h1><%= listing.title %></h1><p><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></p></div><div class="owner-actions"><% if (currUser) { %><form method="POST" action="/favorites/<%= listing._id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button-secondary" type="submit"><i class="fa-<%= isFavorite ? 'solid' : 'regular' %> fa-heart"></i> <%= isFavorite ? 'Saved' : 'Save' %></button></form><% } %><% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %><a class="button-secondary" href="/listings/<%= listing._id %>/edit">Edit listing</a><form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" data-confirm="Delete this listing permanently?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button-danger" type="submit">Delete</button></form><% } %></div></div>
  <div class="detail-grid"><div class="detail-image"><img src="<%= listing.image.url %>" alt="<%= listing.title %> in <%= listing.location %>"></div><aside class="booking-card"><p class="eyebrow">Reserve your stay</p><div class="detail-price"><strong>₹<%= listing.price?.toLocaleString('en-IN') %></strong><span>/ night</span></div><div class="booking-facts"><span><i class="fa-solid fa-user-group"></i> Up to <%= listing.maxGuests || 2 %> guests</span><span><i class="fa-solid fa-house"></i> <%= listing.category || 'Entire stay' %></span><span><i class="fa-regular fa-circle-check"></i> Instant confirmation</span></div><% if (currUser && !(listing.owner && listing.owner._id.equals(currUser._id))) { %><form class="booking-form" method="POST" action="/listings/<%= listing._id %>/bookings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div><label for="checkIn">Check in</label><input id="checkIn" name="booking[checkIn]" type="date" min="<%= new Date().toISOString().slice(0,10) %>" required></div><div><label for="checkOut">Check out</label><input id="checkOut" name="booking[checkOut]" type="date" min="<%= new Date().toISOString().slice(0,10) %>" required></div><label for="guests">Guests</label><select id="guests" name="booking[guests]"><% for (let guestCount = 1; guestCount <= (listing.maxGuests || 2); guestCount++) { %><option value="<%= guestCount %>"><%= guestCount %> <%= guestCount === 1 ? 'guest' : 'guests' %></option><% } %></select><div class="booking-total" data-nightly-price="<%= listing.price %>"><span>Estimated total</span><strong>Choose dates</strong></div><button class="button-primary wide" type="submit">Reserve now</button></form><% } else if (!currUser) { %><a class="button-primary wide" href="/login">Log in to reserve</a><% } else { %><a class="button-secondary wide" href="/dashboard">Manage this listing</a><% } %><small>No payment is collected in this portfolio demo. You can cancel from your dashboard.</small></aside></div>
  <div class="detail-content"><section><p class="eyebrow">Hosted by <%= listing.owner ? listing.owner.username : 'Wanderlust' %></p><h2>About this stay</h2><p class="description"><%= listing.description %></p><div class="amenity-list"><% const amenities = listing.amenities?.length ? listing.amenities : ['Great location', 'Private stay', 'Map verified']; %><% for (const amenity of amenities) { %><span><i class="fa-regular fa-circle-check"></i> <%= amenity %></span><% } %></div></section><section><h2>Where you’ll be</h2><div id="map" aria-label="Map showing <%= listing.location %>"></div></section></div>
  <section class="reviews-section"><div class="section-heading"><div><p class="eyebrow">Guest stories</p><h2>Reviews <span>(<%= listing.reviews.length %>)</span></h2></div></div>
    <% if (currUser) { %><form id="review-form" class="review-form needs-validation" action="/listings/<%= listing.id %>/reviews" method="POST" novalidate><h3>Share your experience</h3><fieldset class="starability-slot"><legend>Your rating</legend><input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="1 star"><% for (let rating = 1; rating <= 5; rating++) { %><input type="radio" id="rate-<%= rating %>" name="review[rating]" value="<%= rating %>"><label for="rate-<%= rating %>" title="<%= rating %> stars"><%= rating %> stars</label><% } %></fieldset><label for="comment">Your review</label><textarea id="comment" name="review[comment]" rows="4" placeholder="What made this stay memorable?" required minlength="3"></textarea><button class="button-primary" type="submit">Publish review</button></form><% } %>
    <% if (listing.reviews.length) { %><div class="review-grid"><% for (const review of listing.reviews) { %><article class="review-card"><div class="review-author"><span><%= review.author?.username?.charAt(0).toUpperCase() || 'G' %></span><div><strong>@<%= review.author?.username || 'guest' %></strong><small>Verified guest</small></div></div><p class="starability-result" data-rating="<%= review.rating || 1 %>"></p><p><%= review.comment %></p><% if (currUser && review.author && review.author._id.equals(currUser._id)) { %><form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" data-confirm="Delete your review?"><button class="text-button" type="submit">Delete review</button></form><% } %></article><% } %></div><% } else { %><div class="empty-reviews"><i class="fa-regular fa-message"></i><p>No reviews yet. Be the first to share a story.</p></div><% } %>
  </section>
</main><script src="/js/map.js"></script>

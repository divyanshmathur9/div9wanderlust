<% if (success && success.length) { %><div class="alert alert-success alert-dismissible fade show" role="status"><i class="fa-regular fa-circle-check"></i> <%= success %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div><% } %>
<% if (error && error.length) { %><div class="alert alert-danger alert-dismissible fade show" role="alert"><i class="fa-solid fa-circle-exclamation"></i> <%= error %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div><% } %>

<% layout("/layouts/boilerplate") %><main class="auth-page"><section class="auth-visual"><div><p class="eyebrow">Join Wanderlust</p><h1>Your next story starts with a place.</h1><p>Save inspiration, share stays, and help travellers find something memorable.</p></div></section><section class="auth-panel"><div class="auth-form"><p class="eyebrow">Create an account</p><h2>Welcome to Wanderlust</h2><p>Already a member? <a href="/login">Log in</a></p><form action="/signup" method="POST" class="needs-validation" novalidate><label for="username">Username</label><input name="username" id="username" type="text" autocomplete="username" required minlength="3"><label for="email">Email</label><input name="email" id="email" type="email" autocomplete="email" required><label for="password">Password</label><input name="password" id="password" type="password" autocomplete="new-password" required minlength="8"><button class="button-primary wide" type="submit">Create account</button></form></div></section></main>

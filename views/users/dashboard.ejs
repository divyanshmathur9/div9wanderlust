<% layout("/layouts/boilerplate") %>
<main class="page-shell dashboard-page"><header class="dashboard-heading"><div><p class="eyebrow"><%= isHost ? 'Host and guest account' : 'Guest account' %></p><h1>Your Wanderlust</h1><p>Manage trips, saved stays, and the places you share.</p></div><a class="button-primary" href="/listings/new">List a new place</a></header>
  <section id="trips" class="dashboard-section"><div class="section-heading"><div><p class="eyebrow">Travel plans</p><h2>Your reservations</h2></div><span><%= bookings.length %> total</span></div>
    <% if (bookings.length) { %><div class="dashboard-grid"><% for (const booking of bookings) { %><article class="trip-card <%= booking.status %>"><% if (booking.listing) { %><img src="<%= booking.listing.image.url %>" alt="<%= booking.listing.title %>"><div><span class="status-label"><%= booking.status %></span><h3><a href="/listings/<%= booking.listing._id %>"><%= booking.listing.title %></a></h3><p><%= booking.checkIn.toLocaleDateString('en-IN') %> – <%= booking.checkOut.toLocaleDateString('en-IN') %> · <%= booking.guests %> guests</p><strong>₹<%= booking.totalPrice.toLocaleString('en-IN') %></strong><% if (booking.status === 'confirmed') { %><form action="/listings/<%= booking.listing._id %>/bookings/<%= booking._id %>/cancel" method="POST" data-confirm="Cancel this reservation?"><button class="text-button" type="submit">Cancel reservation</button></form><% } %></div><% } %></article><% } %></div><% } else { %><div class="dashboard-empty"><p>No reservations yet.</p><a href="/listings">Find your next stay</a></div><% } %>
  </section>
  <section class="dashboard-section"><div class="section-heading"><div><p class="eyebrow">Shortlist</p><h2>Saved stays</h2></div><span><%= favorites.length %> saved</span></div><% if (favorites.length) { %><div class="saved-grid"><% for (const listing of favorites) { %><a href="/listings/<%= listing._id %>"><img src="<%= listing.image.url %>" alt="<%= listing.title %>"><strong><%= listing.title %></strong><span><%= listing.location %></span></a><% } %></div><% } else { %><div class="dashboard-empty"><p>Save stays you want to revisit.</p><a href="/listings">Browse stays</a></div><% } %></section>
  <% if (isHost) { %><section class="dashboard-section"><div class="section-heading"><div><p class="eyebrow">Hosting</p><h2>Your listings</h2></div><span><%= ownedListings.length %> active</span></div><div class="saved-grid"><% for (const listing of ownedListings) { %><a href="/listings/<%= listing._id %>"><img src="<%= listing.image.url %>" alt="<%= listing.title %>"><strong><%= listing.title %></strong><span>₹<%= listing.price.toLocaleString('en-IN') %> / night</span></a><% } %></div></section><% } %>
</main>
